# ==============================================================================
# SUKUGUIDE ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env and configure your secrets.
# NEVER commit your actual .env file with real secrets to Git.

# 1. Supabase Client Configuration (Public / Browser-safe)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Server-side AI Provider Keys (Netlify Environment Variables ONLY)
# DO NOT prefix these with VITE_ to ensure they are NEVER bundled into client JavaScript.
# Configure these in Netlify Dashboard: Site configuration > Environment variables
AI_API_KEY=your-server-side-api-key-here
